# Settings for the load-test stack (docker-compose.load.yml).
#
# Throwaway values for a throwaway database. Nothing here is a secret and
# nothing here is reused anywhere else — the stack is torn down with its volume
# after every run.

DB_NAME=kalo_load
DB_USERNAME=kalo_load
DB_PASSWORD=load-test-only

# Load-test only. Generated once, never used outside this stack.
JWT_SECRET=bG9hZC10ZXN0LW9ubHktc2VjcmV0LW5vdC1mb3ItYW55LXJlYWwtZGVwbG95bWVudA==
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# true for the realistic runs, false for the explicitly labelled baseline.
# scripts/load-test.sh sets this per run; it is here so the file is complete.
RATE_LIMIT_ENABLED=true
