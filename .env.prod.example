# Every environment variable a production deployment of KALO needs.
#
# The values here are PLACEHOLDERS for the local rehearsal
# (docker-compose.prod.yml). Copy this to .env.prod for a real deployment and
# replace everything marked CHANGE ME. Do not commit that file.
#
#   cp .env.prod.example .env.prod

# ---------------------------------------------------------------- database

# CHANGE ME. A dedicated database and role for KALO, not a shared superuser.
DB_NAME=kalo_prod_rehearsal
DB_USERNAME=kalo_rehearsal
DB_PASSWORD=rehearsal-only-not-a-real-password

# Set by docker-compose.prod.yml from the three values above. A real
# deployment against a managed database sets DB_URL directly instead, and
# should require TLS:
#   DB_URL=jdbc:postgresql://db.example.com:5432/kalo?sslmode=require

# --------------------------------------------------------------------- JWT

# CHANGE ME — the one secret with no default. The application will not start
# without it, deliberately: a signing key with a fallback is a signing key
# everybody has.
#
# Generate a fresh one, never reuse this value:
#   openssl rand -base64 48
#
# Rotating it signs every existing session out, which is the intended effect
# if a key is ever exposed.
JWT_SECRET=cmVoZWFyc2FsLW9ubHktcGxhY2Vob2xkZXItbmV2ZXItdXNlLXRoaXMtaW4tcHJvZHVjdGlvbg==

# One hour. Short on purpose: a stolen access token expires quickly, and the
# refresh token covers the inconvenience.
JWT_EXPIRATION=3600000

# Thirty days. A driver signing in at the start of a shift is still signed in
# at the end of the month.
JWT_REFRESH_EXPIRATION=2592000000

# -------------------------------------------------------------------- CORS

# Empty means same-origin only, which is correct when nginx serves the
# frontend and proxies /api — the browser never makes a cross-origin request.
#
# Only set this if the frontend is ever hosted somewhere else, and then list
# exact origins. A wildcard makes the application refuse to start.
#   CORS_ALLOWED_ORIGINS=https://app.kalo.al
CORS_ALLOWED_ORIGINS=

# --------------------------------------------------------------- geocoding

# `nominatim` is the real provider; `static` is a fixed test list used by the
# E2E stack. Production wants nominatim.
GEOCODING_PROVIDER=nominatim

# CHANGE ME. Nominatim's usage policy requires a genuine contact address, and
# they will block a deployment that does not identify itself.
GEOCODING_USER_AGENT=KALO/1.0 (taxi marketplace; contact: ops@kalo.al)

GEOCODING_CACHE_ENABLED=true

# ----------------------------------------------------------------- logging

# Empty gives human-readable console logs. Set to `ecs`, `gelf` or `logstash`
# for structured JSON, which is what a log aggregator wants.
LOG_FORMAT=

# ----------------------------------------------------------- not set here

# SWAGGER_ENABLED — defaults to false. Leave it unset in production. Setting
#   it to true publishes a map of every endpoint.
#
# SPRING_PROFILES_ACTIVE — set to `prod` by docker-compose.prod.yml. It must
#   never be `dev` outside a developer's machine: the dev profile seeds demo
#   accounts and carries a throwaway signing key. DevelopmentSafetyGuard
#   refuses to start if that combination is ever pointed at a real database.
